# evo-scry MCP Server — systemd Environment Configuration
# Place at /etc/evo-scry/evo-scry.env
# See SPEC.md for full documentation of each variable.

# Transport must be "http" for systemd (STDIO doesn't work as a daemon)
EVOSCRY_TRANSPORT=http

# HTTP port for the MCP endpoint
EVOSCRY_PORT=3000

# Search engines: comma-separated list (google, duckduckgo)
EVOSCRY_SEARCH_ENGINES=google,duckduckgo

# Maximum results per engine
EVOSCRY_MAX_RESULTS=10

# Delay between search engine requests (milliseconds)
EVOSCRY_REQUEST_DELAY_MS=1000

# User agent strategy: "rotate" or a custom UA string
EVOSCRY_USER_AGENT=rotate

# Optional HTTP/SOCKS5 proxy for search requests
# EVOSCRY_PROXY_URL=socks5://127.0.0.1:1080

# GitHub Copilot API token (for AI-powered result summarization)
# Generate with: npm run generate-token
# EVOSCRY_COPILOT_TOKEN=

# GitHub OAuth refresh token (for automatic Copilot token renewal)
# EVOSCRY_COPILOT_REFRESH_TOKEN=

# Local model fallback (Ollama) — used when Copilot is unavailable
# EVOSCRY_LOCAL_MODEL_URL=http://localhost:11434
# EVOSCRY_LOCAL_MODEL_NAME=llama3

# Logging level: debug, info, warn, error
EVOSCRY_LOG_LEVEL=info

# Cache TTL in seconds (0 to disable)
EVOSCRY_CACHE_TTL_SECONDS=300
