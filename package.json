{
  "name": "evo-scry",
  "version": "1.0.0",
  "description": "MCP server for internet search via direct Google and DuckDuckGo scraping with AI-powered result normalization",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "evo-scry": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "EVOSCRY_TRANSPORT=http node dist/index.js",
    "dev": "tsx src/index.ts",
    "generate-token": "tsx scripts/generate-copilot-token.ts"
  },
  "keywords": [
    "mcp",
    "search",
    "google",
    "duckduckgo",
    "copilot"
  ],
  "author": "krich11",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
