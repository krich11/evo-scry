# evo-scry MCP Server Configuration
# Copy to .env and customize as needed

# Transport: "stdio" for local MCP clients, "http" for remote/systemd
EVOSCRY_TRANSPORT=stdio

# HTTP port (only used when EVOSCRY_TRANSPORT=http)
EVOSCRY_PORT=3000

# Search engines to use (comma-separated: google,duckduckgo)
EVOSCRY_SEARCH_ENGINES=google,duckduckgo

# Maximum results per engine (default 10)
EVOSCRY_MAX_RESULTS=10

# Delay between search requests in milliseconds (rate limiting)
EVOSCRY_REQUEST_DELAY_MS=1000

# User agent: "rotate" for random rotation, or a custom UA string
EVOSCRY_USER_AGENT=rotate

# Optional HTTP/SOCKS5 proxy URL for search requests
# EVOSCRY_PROXY_URL=socks5://127.0.0.1:1080

# GitHub Copilot token for AI-powered result summarization
# EVOSCRY_COPILOT_TOKEN=

# GitHub Copilot refresh token for automatic token renewal
# EVOSCRY_COPILOT_REFRESH_TOKEN=

# Local model fallback (Ollama) endpoint and model name
# EVOSCRY_LOCAL_MODEL_URL=http://localhost:11434
# EVOSCRY_LOCAL_MODEL_NAME=llama3

# Logging level: debug, info, warn, error
EVOSCRY_LOG_LEVEL=info

# Cache TTL in seconds (0 to disable caching)
EVOSCRY_CACHE_TTL_SECONDS=300
